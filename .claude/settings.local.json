{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(pip3 show:*)",
      "Bash(pip3 install:*)",
      "Bash(export NVM_DIR=\"$HOME/.nvm\")",
      "Bash([ -s \"$NVM_DIR/nvm.sh\" ])",
      "Bash(. \"$NVM_DIR/nvm.sh\")",
      "Bash(npm install:*)",
      "Bash(npm run build:*)",
      "Bash(vercel --version:*)",
      "Bash(vercel --yes:*)",
      "Bash(vercel login)"
    ]
  }
}
